DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3001
HOST=0.0.0.0

# Base URL of the Python fraud-detection engine service
ENGINE_URL="http://localhost:8000"
ENGINE_TIMEOUT_MS=5000

ENGINE_EXPLAIN_TIMEOUT_MS=30000

# Enables POST /events/reset, which empties the demo database from the
# dashboard header. Leave unset anywhere the database is shared with other
# people — a deployed build must not offer this to visitors.
ALLOW_DEMO_RESET="true"
